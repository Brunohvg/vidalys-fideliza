# APENAS DESENVOLVIMENTO LOCAL (compose.yaml). NAO usar no Coolify.
# Homologacao com PostgreSQL externo: .env.coolify.external-db.example
# Copie para .env e substitua todos os placeholders. Nunca versionar segredos.
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
DJANGO_SECRET_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_FORTE
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_DEBUG=0
DJANGO_SECURE_SSL_REDIRECT=0
FRONTEND_PORT=8080

# OAuth Nuvemshop: SOMENTE no secret manager do serviço API na homologação.
# Sem todos estes campos, o sistema informa "não configurado" e bloqueia a conexão.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_TOKEN_KEYS=
NUVEMSHOP_OAUTH_CALLBACK_URL=
NUVEMSHOP_API_USER_AGENT=
