# VIDALYS FIDELIZA — modelo simples para homologacao no Coolify
# Nunca versionar .env com dados reais. Nao colar segredos no chat.
# Compose Location = compose.yaml. PostgreSQL e recurso privado e externo.
# Nunca substituir o painel por placeholders sem antes rotacionar as senhas.

# 1 — ESSENCIAIS (API + worker)
# coolify: literal buildtime=false
DJANGO_SECRET_KEY=SUBSTITUIR_POR_NOVA_CHAVE_FORTE
# coolify: literal buildtime=false
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_PRIVADO:5432/NOME_DO_BANCO
# coolify: buildtime=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,frontend,fideliza-homolog.optarys.com.br,www.fideliza-homolog.optarys.com.br
# coolify: buildtime=false
DJANGO_CSRF_TRUSTED_ORIGINS=https://fideliza-homolog.optarys.com.br,https://www.fideliza-homolog.optarys.com.br

# 2 — ENDERECO PUBLICO (para portal e futuros emails)
# coolify: buildtime=false
FIDELIZA_PUBLIC_BASE_URL=https://fideliza-homolog.optarys.com.br

# 3 — EMAIL (OPCIONAL, nao ativar enquanto faltar senha/validacao)
# EMAIL_HOST=mail.smtp2go.com
# EMAIL_HOST_USER=USUARIO_SMTP
# EMAIL_HOST_PASSWORD=SENHA_PRIVADA
# DEFAULT_FROM_EMAIL=Vidalys <contato@vidalys.com.br>
# FIDELIZA_EMAIL_DELIVERY_ENABLED=1

# 4 — NUVEMSHOP (OPCIONAL, preencher cinco campos juntos)
# NUVEMSHOP_CLIENT_ID=ID_DO_APLICATIVO
# NUVEMSHOP_CLIENT_SECRET=SEGREDO_DO_APP
# NUVEMSHOP_TOKEN_KEYS=CHAVE_FERNET_GERADA
# NUVEMSHOP_OAUTH_CALLBACK_URL=https://fideliza-homolog.optarys.com.br/api/v1/oauth/nuvemshop/callback/
# NUVEMSHOP_API_USER_AGENT=Vidalys Fideliza (contato@vidalys.com.br)

# 5 — NAO CADASTRAR MANUALMENTE
# Flags de recursos desativados ja tem default 0 no Compose.
# DJANGO_DEBUG, HTTPS, Redis e Celery sao definidos no Compose.
# EMAIL_BACKEND, EMAIL_PORT, EMAIL_USE_TLS, EMAIL_USE_SSL e
# SERVER_EMAIL sao definidos/derivados no Compose.
# FIDELIZA_LEDGER_WRITES_ENABLED e bloqueado no codigo.
