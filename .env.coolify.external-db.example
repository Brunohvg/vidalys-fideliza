# Somente referência para a Application Docker Compose externa do Coolify.
# NÃO copie valores deste arquivo para ambientes reais; gerar segredos no Coolify.
# Compose recomendado: compose.coolify.external-db.yaml
# PostgreSQL deve ser recurso independente na rede privada fideliza-homolog.
DJANGO_SECRET_KEY=SUBSTITUIR_NO_SECRET_MANAGER
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_INTERNO:5432/BANCO
DJANGO_ALLOWED_HOSTS=fideliza-homolog.optarys.com.br,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://fideliza-homolog.optarys.com.br

# OAuth só quando aplicativo oficial estiver configurado e autorizado;
# não inserir variáveis vazias com pretensão de OAuth funcional.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_TOKEN_KEYS=
NUVEMSHOP_OAUTH_CALLBACK_URL=
NUVEMSHOP_API_USER_AGENT=

# NÃO configurar manualmente: REDIS_URL e CELERY_BROKER_URL vêm do Compose.
# Não configurar FIDELIZA_LEDGER_WRITES_ENABLED: gravações seguem bloqueadas.

# Nunca liberar sem revisão jurídica, confirmação de e-mail e validação de segurança.
FIDELIZA_PUBLIC_SIGNUP_ENABLED=0

# Configuração SMTP do Mérito, reutilizada no Fideliza sem copiar credenciais reais.
# A conta SMTP2GO deve autorizar contato@vidalys.com.br como remetente.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.smtp2go.com
EMAIL_PORT=587
EMAIL_HOST_USER=gmail-vidalys
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Vidalys <contato@vidalys.com.br>
SERVER_EMAIL=Vidalys <contato@vidalys.com.br>

# O endereço público canônico do Fideliza, acessível e com HTTPS válido.
FIDELIZA_PUBLIC_BASE_URL=https://fideliza-homolog.optarys.com.br

# Desligado por padrão até validar SMTP, remetente e UX de privacidade.
FIDELIZA_EMAIL_DELIVERY_ENABLED=0

# Bloqueado por padrão; requer escopo read_customers autorizado e reinstalação do app.
FIDELIZA_NUVEMSHOP_CUSTOMERS_PREVIEW_ENABLED=0

# Conferência individual de pedidos, SOMENTE leitura e sem cashback.
# read_orders precisa constar no OAuth da loja piloto reautorizada.
FIDELIZA_NUVEMSHOP_ORDERS_PREVIEW_ENABLED=0

# Inbox de avisos assinados, sem conversão em cashback; OFF até piloto verificado.
FIDELIZA_NUVEMSHOP_ORDER_WEBHOOKS_ENABLED=0

# Aprovação humana após e-mail confirmado e cadastro Nuvemshop conferido.
# Não ativa cashback; indisponível por padrão e requer revisão operacional/LGPD.
FIDELIZA_PARTICIPANT_APPROVAL_ENABLED=0

# Modo automático do piloto (NÃO ativa cashback).
# Usar 1 APENAS com conta de teste, read_customers autorizado, SMTP e LGPD
# homologados. Não requer intervenção do lojista para correspondência única.
FIDELIZA_AUTO_CUSTOMER_LINK_ENABLED=0
