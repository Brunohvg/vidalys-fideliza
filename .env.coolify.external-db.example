# Somente referência para a Application Docker Compose externa do Coolify.
# NÃO copie valores deste arquivo para ambientes reais; gerar segredos no Coolify.
# Compose recomendado: compose.coolify.external-db.yaml
# PostgreSQL deve ser recurso independente na rede privada fideliza-homolog.
DJANGO_SECRET_KEY=SUBSTITUIR_NO_SECRET_MANAGER
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_INTERNO:5432/BANCO
DJANGO_ALLOWED_HOSTS=fideliza-homolog.optarys.com.br,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://fideliza-homolog.optarys.com.br

# OAuth só quando aplicativo oficial estiver configurado e autorizado;
# não inserir variáveis vazias com pretensão de OAuth funcional.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_TOKEN_KEYS=
NUVEMSHOP_OAUTH_CALLBACK_URL=
NUVEMSHOP_API_USER_AGENT=

# NÃO configurar manualmente: REDIS_URL e CELERY_BROKER_URL vêm do Compose.
# Não configurar FIDELIZA_LEDGER_WRITES_ENABLED: gravações seguem bloqueadas.
